{
  "target": {
    "repository": "__CHECKOUT__",
    "stateRoot": "__NEW_CANONICAL_TASK_ROOT__",
    "cleanup": "retain"
  },
  "limits": {
    "maxDurationMs": 3600000,
    "maxCalls": 160,
    "maxTotalTokens": 240000000,
    "maxCostUsd": null
  },
  "scenarios": [
    { "id": "g1" },
    { "id": "g2" },
    { "id": "g3" },
    { "id": "g4" },
    { "id": "g5" },
    { "id": "g6" },
    { "id": "g7", "variant": "conflict" },
    { "id": "g7", "variant": "unconfirmed" },
    { "id": "g8", "variant": "fits-required" },
    { "id": "g8", "variant": "required-too-large" }
  ],
  "overrides": [
    {
      "requirement": "gemini-live-observation",
      "reason": "Gemini-only behavior observation; output allowance resolves from native metadata",
      "model": { "provider": "openrouter", "id": "google/gemini-3.8-flash" },
      "config": { "retentionCalibration": { "minFraction": 0.000001, "maxFraction": 0.999999 } }
    },
    {
      "requirement": "measured-required-competition",
      "reason": "Task-only 512-token memory experiment; actual complete response must independently qualify required fit and optional competition",
      "scenario": "g8/fits-required",
      "config": { "nunc": { "memory": { "maxTokens": 512 } } }
    },
    {
      "requirement": "measured-required-overflow",
      "reason": "Task-only 128-token memory experiment; actual necessary set must exceed this limit while an optional candidate fits",
      "scenario": "g8/required-too-large",
      "config": { "nunc": { "memory": { "maxTokens": 128 } } }
    }
  ]
}
