{
  "version": 1,
  "target": {
    "repository": "__CHECKOUT__",
    "stateRoot": "__NEW_STATE_ROOT__",
    "cleanup": "retain"
  },
  "models": [
    {
      "provider": "openai-codex",
      "id": "gpt-6-astra",
      "contextWindow": 272000,
      "maxTokens": 128000,
      "baseUrl": "https://chatgpt.com/backend-api"
    }
  ],
  "limits": {
    "maxCalls": 20,
    "maxTotalTokens": 8000000,
    "maxCostUsd": null,
    "maxDurationMs": 180000,
    "maxOutputTokens": 128000
  },
  "observations": [
    "continuation"
  ],
  "scenarios": [
    {
      "id": "c2",
      "config": {
        "nunc": {
          "memory": {
            "fraction": 0.1
          },
          "rolling": {
            "keepRecentFraction": 0.2
          },
          "extraction": {
            "toolResults": "full",
            "outputTokens": 128000
          },
          "budget": {
            "safetyTokens": 2048,
            "growthTokens": 1024
          }
        },
        "compaction": {
          "enabled": false,
          "reserveTokens": 200000,
          "keepRecentTokens": 1
        },
        "retentionCalibration": {
          "minFraction": 0.0001,
          "maxFraction": 0.95
        }
      }
    }
  ],
  "mode": "controlled"
}
