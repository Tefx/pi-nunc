{
  "name": "pi-nunc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "pi": {
    "extensions": [
      "./dist/src/index.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./pi": {
      "types": "./dist/src/pi/index.d.ts",
      "import": "./dist/src/pi/index.js"
    },
    "./engine": {
      "types": "./dist/src/engine/index.d.ts",
      "import": "./dist/src/engine/index.js"
    }
  },
  "scripts": {
    "check:engine": "node scripts/check.mjs engine",
    "check": "node scripts/check.mjs all",
    "build": "node node_modules/typescript/bin/tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.4.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
